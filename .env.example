# Configure through secure runtime settings. Never commit real values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
GOOGLE_SIGNIN_ENABLED=
STORE_ADMIN_EMAILS=
# Payment provider: authorizenet (default) or chase
PAYMENT_PROVIDER=authorizenet
AUTHORIZENET_ENVIRONMENT=
AUTHORIZENET_API_LOGIN_ID=
AUTHORIZENET_TRANSACTION_KEY=
AUTHORIZENET_SIGNATURE_KEY=
AUTHORIZENET_RETURN_URL=
AUTHORIZENET_CONNECTION_VERIFIED=
CHASE_GATEWAY=
CHASE_ENVIRONMENT=
CHASE_MERCHANT_ID=
CHASE_CLIENT_ID=
CHASE_RESOURCE_ID=
CHASE_CERTIFICATE_THUMBPRINT=
CHASE_PRIVATE_KEY=
CHASE_HOSTED_ORIGIN=
CHASE_RETURN_URL=
CHASE_CONNECTION_VERIFIED=
CHASE_SEGMENT_ID=
COMMERCE_MODE=
COMMERCE_FULFILLMENT_VERIFIED=
# Sales tax: TaxJar when TAXJAR_API_TOKEN is set; otherwise a fixed rate.
# FIXED_TAX_RATE is a percent (e.g. 8.375). Leave FIXED_TAX_STATE unset to tax every order.
FIXED_TAX_RATE=
FIXED_TAX_STATE=
TAXJAR_API_TOKEN=
STORE_ORIGIN_ZIP=
STORE_ORIGIN_STATE=

# Search publishing stays disabled unless all launch controls are explicit.
# Public origin: https://biomodpeptides.com or https://www.biomodpeptides.com only.
# Preview requests remain noindex even if production indexing is enabled.
SEO_PUBLIC_ORIGIN=
SEO_PUBLIC_LAUNCH_APPROVED=false
SEO_INDEXING_ENABLED=false
# Comma-separated exact product slugs, only after product-specific review.
SEO_REVIEWED_PRODUCT_SLUGS=

# Aggregate traffic measurement is disabled unless both runtime settings are valid.
# Canonical https://trybiomod.com only. No analytics cookies or visitor identifiers.
TRAFFIC_MEASUREMENT_ENABLED=false
# UTC ISO timestamp set at actual activation; keep fixed on later deploys.
TRAFFIC_MEASUREMENT_STARTED_AT=
