# Search publishing stays disabled unless all launch controls are explicit.
# Public origin: https://biomodpeptides.com or https://www.biomodpeptides.com only.
# Preview requests remain noindex even if production indexing is enabled.
SEO_PUBLIC_ORIGIN=
SEO_PUBLIC_LAUNCH_APPROVED=false
SEO_INDEXING_ENABLED=false
# Comma-separated exact product slugs, only after product-specific review.
SEO_REVIEWED_PRODUCT_SLUGS=
