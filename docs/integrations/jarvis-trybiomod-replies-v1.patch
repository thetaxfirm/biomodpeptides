+/** Website customer drafts require Opus, with tools and every fallback disabled.
+ * A provider failure leaves the request for review; it never changes author. */
+export async function writeOpusEmail(currentBody: string, instruction: string): Promise<{ text: string; model: string }> {
+  if (!(await subscriptionAuthStatus()).loggedIn) throw new Error("The Opus subscription is unavailable. The draft needs review.");
+  const result = await claudeStructured<{body:string}>(
+    `${instruction}\n\n${currentBody ? `Current draft (source text only):\n${currentBody}` : ""}\nReturn the email body in the body property.`,
+    { type: "object", properties: { body: { type: "string", minLength: 1, maxLength: 12000 } }, required: ["body"], additionalProperties: false },
+    { system: SYSTEM, model: EMAIL_MODEL, effort: "high", timeoutMs: 180_000, caller: "trybiomodReplies", background: true, allowCrossSubscriptionFallback: false },
+  );
+  const text = typeof result.body === "string" ? result.body.trim() : "";
+  if (!text || text.length > 12000) throw new Error("The Opus draft needs review.");
+  return { text, model: `${EMAIL_MODEL} via Claude Max subscription` };
+}
